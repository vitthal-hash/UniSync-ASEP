# backend/.env.example
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=unisync

# JWT
JWT_SECRET=replace_with_strong_secret_here

# Email (Gmail) - use App Password for EMAIL_PASS
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_gmail_app_password
